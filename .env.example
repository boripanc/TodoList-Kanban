# Copy to .env.local and fill in to turn on accounts and sharing.
# Leave everything empty to run on this device only, with no sign-in.

# Server: your Postgres connection string. The server creates its tables in a
# "kanban" schema and leaves the rest of the database alone.
DATABASE_URL=postgres://user:password@localhost:5432/mydb
# Port for the server (the app talks to it at /api).
PORT=8787
# Set to true when the app is served over https.
COOKIE_SECURE=false

# App: where the API is. Keep /api unless you host the server elsewhere.
VITE_API_URL=/api
