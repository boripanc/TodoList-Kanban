# Copy to .env.local to turn on accounts and sharing.
# Without DATABASE_URL the app runs on this device only, with no sign-in.

# Your Postgres connection string. The server creates its tables in a "kanban"
# schema and leaves the rest of the database alone.
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Port for the server (default 8787).
PORT=8787

# Set to true when the app is served over https.
COOKIE_SECURE=false

# The site's public address, for OAuth when Claude connects to /api/mcp.
# Optional: by default it comes from the request and proxy headers.
# PUBLIC_URL=https://kanban.example.com

# Encrypts saved credentials (Credentials menu). Use a long random value, e.g.
# from `openssl rand -base64 32`, and keep it safe: credentials saved with it
# can't be opened without it. Without it, the server generates a key and keeps
# it in the database.
# CREDENTIALS_KEY=

# Sign in with SSO (OpenID Connect), next to email and password. Register the
# redirect URI https://your-domain/api/auth/sso/callback at the provider.
# Keep the secret out of git: set these in your host's environment.
# SSO_ISSUER=https://sso.example.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_NAME=SSO

# Only if the server runs somewhere other than /api on the same site.
# Set to "off" to hide sign-in entirely.
# VITE_API_URL=/api
